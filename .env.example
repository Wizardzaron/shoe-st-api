SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://user:password@localhost:5432/shoes
FRONTEND_URL=http://localhost:3000
# Use false and SESSION_COOKIE_SAMESITE=Lax in local configuration if needed.
COOKIE_SECURE=true
# Shared Redis is required for consistent limits across serverless workers.
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
SENDER_EMAIL=
SENDER_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
